# =============================================================================
# IT Help Desk — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running docker compose up.
# NEVER commit the .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------------------
# SA password — must meet SQL Server complexity requirements:
# at least 8 chars, uppercase, lowercase, digit, special character.
MSSQL_SA_PASSWORD=YourStr0ng!P@ssword

# Database name used by Identity Service.
MSSQL_DATABASE=IdentityDb

# ---------------------------------------------------------------------------
# JWT Signing (RS256 — asymmetric)
# ---------------------------------------------------------------------------
# Path to the RSA private key file (PEM format) mounted into the container.
# The public key is derived from this and exposed via the JWKS endpoint.
# Generate a key pair before first run:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem

# JWT issuer — must match what the API Gateway and other services expect.
JWT_ISSUER=it-helpdesk-identity

# JWT audience — must match what the API Gateway validates.
JWT_AUDIENCE=it-helpdesk-api

# Access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15

# Refresh token lifetime in days.
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---------------------------------------------------------------------------
# AI Service <-> Ticket Service (scoped service identity, ARCHITECTURE §6.3)
# ---------------------------------------------------------------------------
# Shared secret that lets the AI service perform its ONE scoped write: closing
# a ticket from "Resolved - Pending Confirmation" to "Closed" (status 4).
# The ticket service rejects any other transition made with this key.
# Generate with: openssl rand -hex 32
AI_SERVICE_KEY=change-me-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Search Service <-> Ticket Service (scoped service identity)
# ---------------------------------------------------------------------------
# Shared secret that lets the Search Service backfill the closed-ticket index
# from the ticket service's internal GET /api/tickets/index-sync endpoint.
# Generate with: openssl rand -hex 32
SEARCH_SERVICE_KEY=change-me-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Identity Service <-> Notification Service (scoped service identity)
# ---------------------------------------------------------------------------
# Shared secret that lets the Identity Service send email (e.g. password reset
# links) through the notification service's internal POST /api/email/send
# endpoint. Requests without a matching X-Notification-Service-Key header are
# rejected with 401.
# Generate with: openssl rand -hex 32
NOTIFICATION_SERVICE_KEY=change-me-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Base URL the browser uses to reach the API gateway. Inlined into the client
# bundle at BUILD time (docker build --build-arg NEXT_PUBLIC_API_URL=...), so
# changing it requires rebuilding the frontend image. Defaults to the gateway
# on localhost when unset.
NEXT_PUBLIC_API_URL=http://localhost:5000
